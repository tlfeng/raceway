#!/usr/bin/env bash
# ============================================================================
# vm-bench.env —— 三虚机 esrally 性能测试共享配置（模板）
#   cp vm-bench.env.example vm-bench.env 后按环境填写；vm-bench.env 不入库
# 运行位置：驱动宿主机（由各脚本 source，勿直接执行）
# ============================================================================

# ---- ibs 部署 ----------------------------------------------------------------
# 集群生命周期统一走 ibs CLI（ops.deploy / ops.clean / ops.status），systemd 托管
IBS_BASE=/infini                        # ibs 安装根（与 ibs .env BASE_DIR 一致）
IBS_ROOT=/opt/raceway/ibs               # ibs 仓库在驱动宿主机上的位置

# ---- 拓扑（单事实源 = ibs ip.txt）---------------------------------------------
# 节点列表/数量从 $IBS_ROOT/configs/ip.txt 派生：集群节点 = 主机名不以 esrally 开头的行
# （esrally 行是驱动器）。2~N 节点均可，无需在此维护 IP 列表。
VM_SSH_OPTS=(-o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=8 -o ServerAliveInterval=15)
# 节点命名模板（ibs 部署/切换引擎时按序改写 ip.txt 主机名）
VM_NODES_EZ=(easysearch-0001 easysearch-0002 easysearch-0003 easysearch-0004 easysearch-0005)
VM_NODES_ES=(elasticsearch-0001 elasticsearch-0002 elasticsearch-0003 elasticsearch-0004 elasticsearch-0005)
# 可选：KVM 客户机名（与节点一一对应，virsh 环境指纹用）；缺省回退集群节点名
# VM_NAMES=(node-1 node-2 node-3)

# ---- 虚机侧布局 -------------------------------------------------------------
BENCH_BASE=/opt/raceway               # 监控落位根；reset --purge all 时回滚 sysctl/limits
MON_DIR=/opt/raceway/monitor          # 监控脚本与 CSV
ENGINE_MARK=${ENGINE_MARK:-$IBS_BASE} # 监控进程归因标记：cmdline 含此串的进程视为被测引擎
HTTP_PORT=9200
HEAP=${HEAP:-16g}                     # 每节点堆（32G 虚机 → 内存/2）
ADMIN_USER=admin
ADMIN_PW='CHANGE_ME'                  # ≥9 位（easysearch initialize.sh 要求）
EZ_RUN_USER=easysearch
ES_RUN_USER=elastic

# ---- 驱动宿主机布局 ----------------------------------------------------------
ROOT=/opt/raceway
PKG_DIR=$ROOT/pkg                     # 安装包（ibs 部署用本地包，版本号从文件名取）
RESULTS_ROOT=$ROOT/campaigns
ENV_ID=${ENV_ID:-bench-3node-32c32g}  # bench-env 台账主键：一套环境一个 id
RALLY=esrally                          # esrally 可执行（-wrapper 脚本亦可）

# ---- 安装包（放到 PKG_DIR；包名含版本，配置用 ENGINE_NAME/VERSION/BUILD 推导） ----
# easysearch-2.5.0-3015-linux-amd64-bundle.tar.gz
# elasticsearch-8.19.23-linux-x86_64.tar.gz

# ---- track ------------------------------------------------------------------
# 每赛道基座目录需含 track.json + 语料；下游变体由 prepare-*.sh 自动生成
TRACK_GEO=$ROOT/tracks/geo                        # geonames（write-only/query-only，支持 number_of_shards）
TRACK_HNSW_BASE=$ROOT/tracks/hnsw2m-2m            # 96 维 HNSW 2M（上游 2 分片写死）
TRACK_HNSW_S3=$ROOT/tracks/hnsw2m-2m-s3           # 3 分片变体（自动生成）
TRACK_HV1024=$ROOT/tracks/hv1024-s3               # 1024 维 float HNSW 3 分片变体（自动生成；语料用 HV_CORPUS/HV_QUERIES_BZ2 指定）
TRACK_NESTED_BASE=$ROOT/tracks/nested             # 上游 nested 赛道
TRACK_NESTED_S3=$ROOT/tracks/nested-s3            # 3 分片变体（自动生成）
TRACK_GEO_DEF=$ROOT/tracks/geo-codec-def          # index.codec=default（LZ4）
TRACK_GEO_ZSTD_SR=$ROOT/tracks/geo-codec-zstd-sr  # index.codec=ZSTD + source_reuse（easysearch 专有）
TRACK_GEO_BC=$ROOT/tracks/geo-codec-bc            # index.codec=best_compression（DEFLATE）

# ---- 卡点阈值（数据可信度） ---------------------------------------------------
# 静默卡点（precheck.sh）与集群卡点轮询；缺键时脚本有内置默认值
QUIET_LOAD1=3          # 虚机 1 分钟负载
QUIET_STEAL=2          # cpu steal %（赛后 ENV 判定同口径：verdict 默认值在 load-monitor.sh 内）
QUIET_BENCH_CPU=1      # 被测引擎进程 CPU %（赛前应为 0：>0 即残留引擎或 ENGINE_MARK 错位）
QUIET_FOREIGN_CPU=5    # 非被测引擎进程 CPU %
QUIET_FREE_GB=20       # 磁盘可用 GB
CLUSTER_WAIT_SEC=300   # 集群卡点轮询超时
# 注：赛后判定阈值（VERDICT_*）在虚机侧 load-monitor.sh 内，ssh 不透传环境变量，
# 写在这里不生效——改默认值直接改脚本。

# ---- race 超时（秒） ---------------------------------------------------------
TIMEOUT_GEO_W=14400;  TIMEOUT_GEO_Q=5400
TIMEOUT_HNSW_W=10800; TIMEOUT_HNSW_Q=5400
TIMEOUT_HV1024_W=10800; TIMEOUT_HV1024_Q=5400
TIMEOUT_NESTED_W=14400; TIMEOUT_NESTED_Q=5400
