#!/usr/bin/env bash
# ============================================================================
# vm-bench.env —— 三虚机 esrally 性能测试共享配置（模板）
#   cp vm-bench.env.example vm-bench.env 后按环境填写；vm-bench.env 不入库
# 运行位置：驱动宿主机（由各脚本 source，勿直接执行）
# ============================================================================

# ---- ibs 部署 ----------------------------------------------------------------
# 集群生命周期统一走 ibs CLI（ops.deploy / ops.clean / ops.status），systemd 托管
IBS_BASE=/infini                        # ibs 安装根（与 ibs .env BASE_DIR 一致）
IBS_ROOT=/opt/raceway/ibs               # ibs 仓库在驱动宿主机上的位置

# ---- 拓扑（单事实源 = ibs ip.txt）---------------------------------------------
# 节点列表/数量从 $IBS_ROOT/configs/ip.txt 派生：集群节点 = 主机名不以 esrally 开头的行
# （esrally 行是驱动器）。2~N 节点均可，无需在此维护 IP 列表。
VM_SSH_OPTS=(-o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=8 -o ServerAliveInterval=15)
# 节点命名模板（ibs 部署/切换引擎时按序改写 ip.txt 主机名）
VM_NODES_EZ=(easysearch-0001 easysearch-0002 easysearch-0003 easysearch-0004 easysearch-0005)
VM_NODES_ES=(elasticsearch-0001 elasticsearch-0002 elasticsearch-0003 elasticsearch-0004 elasticsearch-0005)
VM_NODES_OS=(opensearch-0001 opensearch-0002 opensearch-0003)
# 可选：KVM 客户机名（与节点一一对应，virsh 环境指纹用）；缺省回退集群节点名
# VM_NAMES=(node-1 node-2 node-3)

# ---- 虚机侧布局 -------------------------------------------------------------
BENCH_BASE=/opt/raceway               # 监控落位根；reset --purge all 时回滚 sysctl/limits
MON_DIR=/opt/raceway/monitor          # 监控脚本与 CSV
ENGINE_MARK=${ENGINE_MARK:-$IBS_BASE} # 监控进程归因标记：cmdline 含此串的进程视为被测引擎
HTTP_PORT=9200
HEAP=${HEAP:-16g}                     # 每节点堆（32G 虚机 → 内存/2）
ADMIN_USER=admin
ADMIN_PW='CHANGE_ME'                  # ≥9 位（easysearch initialize.sh 要求）
EZ_RUN_USER=easysearch
ES_RUN_USER=elastic
OS_RUN_USER=opensearch

# ---- 驱动宿主机布局 ----------------------------------------------------------
ROOT=/opt/raceway
PKG_DIR=$ROOT/pkg                     # 安装包（ibs 部署用本地包，版本号从文件名取）
# runner 从首次起跑持久化 PLAN.tsv/PLAN.sha256/DEADLINE；续跑口径变化必须换 CAMP_ID。
# RESULTS_ROOT 同时是实例互斥范围（.runner.lock）；共用被测集群的入口必须共用此目录。
# 真实执行使用 campaign/runtime 下只读脚本快照；部署仍应等待当前 campaign 结束。
RESULTS_ROOT=$ROOT/campaigns
ENV_ID=${ENV_ID:-bench-3node-32c32g}  # bench-env 台账主键：一套环境一个 id
RALLY=esrally                          # esrally 可执行（-wrapper 脚本亦可）
# 必须是同一 Rally 环境的 Python；wrapper 激活的 venv 不会传播回 runner。
# expected_tasks 只离线渲染 full 模板；--help/list/dry-run 不导入 Rally。
RALLY_PYTHON=python3                    # 例如 /opt/esrally-2.13.0/bin/python

# ---- 安装包（放到 PKG_DIR；包名含版本，配置用 ENGINE_NAME/VERSION/BUILD 推导） ----
# 当前在测的版本线（2026-11-04）：
#   easysearch 2.5.1-3045   ← 2.5.1 线当前版本（stable/bundle 直链）
#   easysearch 2.5.0-3015   ← 2.5.0 线当前版本（snapshot/bundle 直链）
#   easysearch 2.4.0-2975   ← 2.4.0 对照线
#   elasticsearch 8.19.23
#
# ⚠️ 版本清单的**真身不在本文件**：部署层由 ibs 的 configs/.env 的
#    EZS_VERSIONS / ES_VERSIONS 决定（ops.deploy 按它选包），这里只作人工对照。
#    每场的引擎版本也不从这里推导 —— 由配置文件行的
#    ENGINE_NAME / ENGINE_VERSION / ENGINE_BUILD 决定（只有 easysearch 有 BUILD）。

# ---- track ------------------------------------------------------------------
# 赛道定义定版在仓库 tracks/ 下（geonames / hv1024 / nested / hv1024x* / hnsw / ds-*），
# runner 直接消费 —— 这里不需要再配赛道路径。
# 下面这个是**机器本地**的语料与查询集（GB 级，不进 git）：
TRACK_HNSW_BASE=$ROOT/corpora-hnsw                # hnsw 语料与查询集目录（documents-2m.json / queries.json）
# 旧的单赛道路径变量（TRACK_GEO / TRACK_HNSW_S3 / TRACK_HV1024 / TRACK_NESTED_* / TRACK_GEO_*）
# 已随"压缩变体走 --track-params、赛道定义定版进 tracks/"作废，留在 env 里也不生效。

# ---- hv1024 系语料（起跑前用来软链语料 / 生成查询集）-------------------------
# 只在**语料软链或 queries.json 缺失**时才需要（压测机上已有就不用设）。
HV_CORPUS=/testing/aijiami-perf-test/hv-bench/corpora/documents-jina-float.json
HV_QUERIES_BZ2=/testing/aijiami-perf-test/hv-bench/corpora/queries.json.bz2

# ---- 卡点阈值（数据可信度） ---------------------------------------------------
# 主旋钮是 VERDICT_*（赛后 ENV 判定；runner 经 ssh 传给虚机侧 load-monitor）。
# 赛前静默卡点同口径的项（steal / 外来进程）缺省**继承** VERDICT_* —— 一处改，两边生效；
# 只有赛前想单独收紧时才需要显式写 QUIET_STEAL / QUIET_FOREIGN_CPU。
# 所有节点 summary 必须为 OK 且 samples>0 才能 VALID；WARN / CONTAMINATED / NO-DATA 均 ENV-FAIL。
# MON_DIR 会作为 RACEWAY_MON_DIR 显式传给远端采样器；停止采样必须给本场 tag。
VERDICT_STEAL_MAX=2.0   # 任一采样 steal_max 超过 → 该场 CONTAMINATED；赛前 steal_max ≥ 此值 → 卡点 FAIL
VERDICT_FOREIGN_MAX=5   # 外来进程 CPU 峰值超过 → 赛后 WARN；赛前 ≥ 此值 → 卡点 FAIL
# 赛前卡点专属项（赛后判定没有对应物）
QUIET_LOAD1=3           # 虚机 1 分钟负载
QUIET_BENCH_CPU=1       # 被测引擎进程 CPU %（赛前应为 0：>0 即残留引擎或 ENGINE_MARK 错位）
QUIET_FREE_GB=20        # 磁盘可用 GB
CLUSTER_WAIT_SEC=300    # 集群卡点轮询超时
# 逃生阀：HOST_QUIET_PORTS="" / HOST_QUIET_AUTOSTART="" 可关掉宿主旁路检查（见 precheck.sh）

# ---- race 超时（秒） ---------------------------------------------------------
TIMEOUT_GEO_W=14400;  TIMEOUT_GEO_Q=5400
TIMEOUT_HNSW_W=10800; TIMEOUT_HNSW_Q=5400
TIMEOUT_HV1024_W=10800; TIMEOUT_HV1024_Q=5400
TIMEOUT_NESTED_W=14400; TIMEOUT_NESTED_Q=5400
# upsert/update 对比赛道（缺省继承 geo 的超时；实测全场 ~32min，geo 默认够用）
# TIMEOUT_UPSERT_W=14400; TIMEOUT_UPSERT_Q=5400
