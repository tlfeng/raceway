*.pyc
*.log
.DS_Store

# Kibana 建板产物：随 benchmark-result-env 现场数据生成，含环境指纹与场次统计，
# 每次生成都会随数据变化 → 不入库，按需本地重建（见 kibana/README.md）
kibana/kibana-objects.ndjson

# 内部排程计划：含具体场次安排与本机路径，不随公共库公开。
# 车定义排程用 --cars-file / RACEWAY_CARS_FILE 指定本地留存副本。
schedules/

# —— 部署机（/testing/raceway）运行时资产：只留本地，不入库 ——
# pkg/ 发行包缓存；corpora* 语料本体；ibs 独立部署（另一个仓库）
pkg/
corpora*/
ibs/
# stage 落地暂存；dsfix 历史工件；monitor = load-monitor 采样输出（MON_DIR）
stage/
dsfix/
monitor/
*.bak
*.bak-*
.bak-sync-*/
.old-arm-*/
# 现场私有配置与第三方件
my3.conf
echarts.min.js
conf-*.conf
# tracks/ 只入库静态定义；语料本体与派生数据留在部署机（GB 级，可再生）
tracks/**/documents-*
tracks/**/*.offset
tracks/**/queries.json
tracks/**/queries*.jsonl
tracks/**/truth.jsonl
tracks/**/challenges/full.json
