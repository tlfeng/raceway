vm-bench.env
campaigns/
exports/
logs/
__pycache__/
*.pyc
*.log
.DS_Store

# Kibana 建板产物：随 benchmark-result-env 现场数据生成，含环境指纹与场次统计，
# 每次生成都会随数据变化 → 不入库，按需本地重建（见 kibana/README.md）
kibana/kibana-objects.ndjson

# 内部排程计划：含具体场次安排与本机路径，不随公共库公开。
# 车定义排程用 --cars-file / RACEWAY_CARS_FILE 指定本地留存副本。
schedules/

# —— 部署机（/testing/raceway）运行时资产：只留本地，不入库 ——
# pkg/ 发行包缓存；corpora* 语料本体；ibs 独立部署（另一个仓库）
pkg/
corpora*/
ibs/
# stage 落地暂存；dsfix 历史工件；monitor = load-monitor 采样输出（MON_DIR）
stage/
dsfix/
monitor/
*.bak
*.bak-*
.bak-sync-*/
.old-arm-*/
# 现场私有配置与第三方件
my3.conf
echarts.min.js
conf-*.conf
# tracks/ 只入库静态定义；语料本体与派生数据留在部署机（GB 级，可再生）
tracks/**/documents-*
tracks/**/*.offset
tracks/**/queries.json
tracks/**/queries*.jsonl
tracks/**/truth.jsonl
# full.json 默认是派生产物（write-only + query-only → derive_full_challenge 现生成），
# 不入库。例外：geonames-upsert 没有 write-only/query-only 可派生 —— 它的 full.json
# 是手写主定义（upsert 三段流 + native-update 基线），必须随库分发。
tracks/**/challenges/full.json
!tracks/geonames-upsert/challenges/full.json

# —— 部署机（/testing/raceway）本地留档：只留机器上，不入库 ——
# 赛道定义已定版进库（tracks/geonames、tracks/hv1024、tracks/nested、tracks/hv1024x*）。
# 下面这些只留在机器上：旧变体目录（切换前的残留）、ds-* 定义（还没回灌）、
# hnsw2m-2m-s3（由 run-bench 的 prepare_hnsw_s3 生成）
tracks/ds-*/
tracks/geo-codec-*/
tracks/hnsw-codec-*/
tracks/hnsw2m-2m-s3/
tracks/hv1024-s3/
tracks/hvtp200k-*/
tracks/nested-s3/
# 部署机运维脚本（与库内脚本同名的本地版本）
disk-janitor.sh
mon-campaign.sh
post-run-ez251.sh
probe.sh
reexport_p04_fix.sh
# 已被库内工具取代的旧件：bench-report.py（库内已删 HTML 报告链路）、
# car_label.py（车身份口径已由 identity.py 收口）
bench-report.py
car_label.py
