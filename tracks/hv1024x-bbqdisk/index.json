{
  "settings": {
    "index": {
      "number_of_shards": 3,
      "number_of_replicas": 0{% if encrypted_store is defined and encrypted_store %}, "store.type": "encrypted", "encryption.profile": "index"{% endif %}
    }
  },
  "mappings": {
    "dynamic": "false",
    "_source": {
      "excludes": [
        "emb"
      ]
    },
    "properties": {
      "docid": {
        "type": "keyword"
      },
      "emb": {
        "type": "dense_vector",
        "dims": 1024,
        "index": true,
        "similarity": "dot_product",
        "index_options": {
          "type": "bbq_disk"
        }
      }
    }
  }
}