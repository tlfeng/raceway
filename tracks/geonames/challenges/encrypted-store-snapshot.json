{
  "name": "encrypted-store-snapshot",
  "description": "Easysearch 索引加密 + 快照加密全链路探针：写段烘入 index.store.type=encrypted / index.encryption.profile=index（与 encrypted-store 挑战逐项同序同预算），随后在**加密仓库**上走完整快照闭环 —— delete-snapshot-repository 预清场（忽略 404，幂等重跑）→ 注册 type=encrypted 仓库（委托 fs，location 走 --track-params）→ create-snapshot（异步）→ wait-for-snapshot-create（快照字节数/吞吐）→ 删原索引 → restore（异步）→ wait-for-recovery（恢复字节数/吞吐，恢复出的索引即原 geonames）→ 健康检查 → 查段（与 query-only 逐项同序同预算，跑在**快照恢复出的索引**上）。跑前集群须装好索引加密与 repository-encrypted（快照加密）插件并在全部节点导入 Keystore 主密钥；仓库 location 为数据节点本地路径。仅 Easysearch 可跑（ES 不认 index.encryption.profile 与 type=encrypted 仓库）。",
  "schedule": [
        {
          "operation": "delete-index"
        },
        {
          "operation": {
            "operation-type": "create-index",
            "settings": {%- set p_enc_settings = {} -%}{%- if index_settings is defined and index_settings is mapping %}{%- set _ = p_enc_settings.update(index_settings) -%}{%- endif %}{%- set _ = p_enc_settings.update({"index.store.type": "encrypted", "index.encryption.profile": "index"}) -%}{{ p_enc_settings | tojson }}
          }
        },
        {
          "name": "check-cluster-health",
          "operation": {
            "operation-type": "cluster-health",
            "index": "geonames",
            "request-params": {
              "wait_for_status": "{{cluster_health | default('green')}}",
              "wait_for_no_relocating_shards": "true"
            },
            "retry-until-success": true
          }
        },
        {
          "operation": "index-append",
          "warmup-time-period": 70,
          "clients": {{bulk_indexing_clients | default(8)}},
          "ignore-response-error-level": "{{error_level | default('non-fatal')}}"
        },
        {
          "name": "refresh-after-index",
          "operation": "refresh"
        },
        {
          "operation": {
            "operation-type": "force-merge",
            "request-timeout": 7200,
            "max-num-segments": {{max_num_segments | default(1)}}
          }
        },
        {
          "name": "refresh-after-force-merge",
          "operation": "refresh"
        },
        {
          "name": "wait-until-merges-finish",
          "operation": {
            "operation-type": "index-stats",
            "index": "_all",
            "condition": {
              "path": "_all.total.merges.current",
              "expected-value": 0
            },
            "retry-until-success": true,
            "include-in-reporting": false
          }
        },
        {
          "name": "delete-snapshot-repository",
          "operation": {
            "operation-type": "delete-snapshot-repository",
            "repository": "{{snapshot_repository | default('raceway-encrypted')}}"
          }
        },
        {
          "name": "create-repository",
          "operation": {
            "operation-type": "create-snapshot-repository",
            "repository": "{{snapshot_repository | default('raceway-encrypted')}}",
            "body": {
              "type": "encrypted",
              "settings": {
                "delegate_type": "{{snapshot_repo_delegate | default('fs')}}",
                "location": "{{snapshot_repo_location | default('/tmp/raceway-snapshot-repo')}}"
                {%- if snapshot_repo_profile is defined and snapshot_repo_profile %}
                ,"encryption.profile": "{{snapshot_repo_profile}}"
                {%- endif %}
              }
            }
          }
        },
        {
          "name": "create-snapshot",
          "operation": {
            "operation-type": "create-snapshot",
            "repository": "{{snapshot_repository | default('raceway-encrypted')}}",
            "snapshot": "{{snapshot_name | default('geonames-enc')}}",
            "wait-for-completion": false,
            "request-timeout": 7200,
            "body": {
              "indices": "geonames",
              "include_global_state": false
            }
          }
        },
        {
          "name": "wait-for-snapshot-create",
          "operation": {
            "operation-type": "wait-for-snapshot-create",
            "repository": "{{snapshot_repository | default('raceway-encrypted')}}",
            "completion-recheck-wait-period": 2
          }
        },
        {
          "name": "delete-index-before-restore",
          "operation": "delete-index"
        },
        {
          "name": "restore-snapshot",
          "operation": {
            "operation-type": "restore-snapshot",
            "repository": "{{snapshot_repository | default('raceway-encrypted')}}",
            "snapshot": "{{snapshot_name | default('geonames-enc')}}",
            "wait-for-completion": false,
            "request-timeout": 7200,
            "body": {
              "indices": "geonames",
              "include_global_state": false
            }
          }
        },
        {
          "name": "wait-for-recovery",
          "operation": {
            "operation-type": "wait-for-recovery",
            "index": "geonames",
            "completion-recheck-wait-period": 2
          }
        },
        {
          "name": "check-cluster-health-after-restore",
          "operation": {
            "operation-type": "cluster-health",
            "index": "geonames",
            "request-params": {
              "wait_for_status": "{{cluster_health | default('green')}}",
              "wait_for_no_relocating_shards": "true"
            },
            "retry-until-success": true
          }
        },
        {% if post_ingest_sleep|default(false) %}
        {
          "name": "post-ingest-sleep",
          "operation": {
            "operation-type": "sleep",
            "duration": {{ post_ingest_sleep_duration|default(30) }}
          }
        },
        {% endif %}
        {
          "operation": "index-stats",
          "warmup-iterations": 500,
          "iterations": 1000,
          "target-throughput": 90
        },
        {
          "operation": "node-stats",
          "warmup-iterations": 100,
          "iterations": 1000
        },
        {
          "operation": "default",
          "warmup-iterations": 500,
          "iterations": 1000,
          "target-throughput": 50
        },
        {
          "operation": "term",
          "warmup-iterations": 500,
          "iterations": 1000,
          "target-throughput": 100
        },
        {
          "operation": "phrase",
          "warmup-iterations": 500,
          "iterations": 1000,
          "target-throughput": 110
        },
        {
          "operation": "country_agg_uncached",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 3
        },
        {
          "operation": "country_agg_cached",
          "warmup-iterations": 1000,
          "iterations": 1000,
          "target-throughput": 100
        },
        {
          "operation": "scroll",
          "warmup-iterations": 200,
          "iterations": 100,
          "#COMMENT": "Throughput is considered per request. So we issue one scroll request per second which will retrieve 25 pages",
          "target-throughput": 0.8
        },
        {
          "operation": "expression",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 1.5
        },
        {
          "operation": "painless_static",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 1.1
        },
        {
          "operation": "painless_dynamic",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 1.4
        },
        {
          "operation": "decay_geo_gauss_function_score",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 1
        },
        {
          "operation": "decay_geo_gauss_script_score",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 1
        },
        {
          "operation": "field_value_function_score",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 1.5
        },
        {
          "operation": "field_value_script_score",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 1.5
        },
        {
          "operation": "large_terms",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 1.1
        },
        {
          "operation": "large_filtered_terms",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 1.1
        },
        {
          "operation": "large_prohibited_terms",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 1.1
        },
        {
          "operation": "desc_sort_population",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 1.5
        },
        {
          "operation": "desc_sort_population_can_match_shortcut",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 1.5
        },
        {
          "operation": "desc_sort_population_no_can_match_shortcut",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 1.5
        },
        {
          "operation": "asc_sort_population",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 1.5
        },
        {
          "operation": "asc_sort_with_after_population",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 1.5
        },
        {
          "operation": "desc_sort_geonameid",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 6
        },
        {
          "operation": "desc_sort_with_after_geonameid",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 6
        },
        {
          "operation": "asc_sort_geonameid",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 6
        },
        {
          "operation": "asc_sort_with_after_geonameid",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 6
        },
        {
          "operation": "sort_country_code_can_match_shortcut",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 1.5
        },
        {
          "operation": "sort_country_code_no_can_match_shortcut",
          "warmup-iterations": 200,
          "iterations": 100,
          "target-throughput": 1.5
        }
  ]
}
