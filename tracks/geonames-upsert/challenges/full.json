    {
      "name": "full",
      "description": "Raceway entry challenge: scenario A = upsert lifecycle (cold insert / real hot update / mixed via doc_as_upsert), scenario B = plain update without doc_as_upsert. Each cycle rebuilds the same natural-id corpus; bulk sizes, client counts and hot update content are identical.",
      "schedule": [
        {#-- 场景 A：upsert 生命周期 -------------------------------- --#}
        {
          "operation": {
            "name": "delete-index",
            "operation-type": "delete-index",
            "only-if-exists": true
          }
        },
        {
          "operation": {
            "name": "create-index",
            "operation-type": "create-index",
            "settings": {{index_settings | default({}) | tojson}}
          }
        },
        {
          "name": "check-cluster-health",
          "operation": {
            "operation-type": "cluster-health",
            "index": "geonames-upsert",
            "request-params": {
              "wait_for_status": "{{cluster_health | default('green')}}",
              "wait_for_no_relocating_shards": "true"
            },
            "retry-until-success": true
          }
        },
        {
          "name": "upsert-insert-cold",
          "operation": "upsert-insert",
          "warmup-time-period": {{warmup_time_period | default(30)}},
          "clients": {{bulk_indexing_clients | default(8)}},
          "ignore-response-error-level": "{{error_level | default('non-fatal')}}"
        },
        {
          "name": "refresh-after-insert",
          "operation": "refresh"
        },
        {
          "name": "upsert-update-hot",
          "operation": "upsert-update",
          "warmup-time-period": {{warmup_time_period | default(30)}},
          "clients": {{bulk_indexing_clients | default(8)}},
          "ignore-response-error-level": "{{error_level | default('non-fatal')}}"
        },
        {
          "name": "refresh-after-update",
          "operation": "refresh"
        },
        {
          "name": "upsert-mixed",
          "operation": "upsert-mixed",
          "warmup-time-period": {{warmup_time_period | default(30)}},
          "clients": {{bulk_indexing_clients | default(8)}},
          "ignore-response-error-level": "{{error_level | default('non-fatal')}}"
        },
        {
          "name": "refresh-after-mixed",
          "operation": "refresh"
        },
        {#-- 场景 B：纯 update 对照（同一自然 ID 全集，逐文档真实重写） --#}
        {
          "operation": {
            "name": "native-delete-index",
            "operation-type": "delete-index",
            "only-if-exists": true
          }
        },
        {
          "operation": {
            "name": "native-create-index",
            "operation-type": "create-index",
            "settings": {{index_settings | default({}) | tojson}}
          }
        },
        {
          "name": "native-check-cluster-health",
          "operation": {
            "operation-type": "cluster-health",
            "index": "geonames-upsert",
            "request-params": {
              "wait_for_status": "{{cluster_health | default('green')}}",
              "wait_for_no_relocating_shards": "true"
            },
            "retry-until-success": true
          }
        },
        {
          "name": "index-append-with-ids",
          "operation": "index-append-ids",
          "warmup-time-period": {{warmup_time_period | default(30)}},
          "clients": {{bulk_indexing_clients | default(8)}},
          "ignore-response-error-level": "{{error_level | default('non-fatal')}}"
        },
        {
          "name": "refresh-after-append",
          "operation": "refresh"
        },
        {
          "name": "index-update-native",
          "operation": "index-update-native",
          "warmup-time-period": {{warmup_time_period | default(30)}},
          "clients": {{bulk_indexing_clients | default(8)}},
          "ignore-response-error-level": "{{error_level | default('non-fatal')}}"
        },
        {
          "name": "refresh-after-native-update",
          "operation": "refresh"
        },
        {% if include_force_merge | default(false) %}
        {
          "operation": "force-merge"
        },
        {
          "name": "wait-until-merges-finish",
          "operation": "wait-until-merges-finish"
        },
        {% endif %}
        {
          "name": "final-stats",
          "operation": "index-stats",
          "warmup-iterations": 100,
          "iterations": 100
        }
      ]
    }
