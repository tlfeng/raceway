    {% set p_bulk_size = bulk_size | default(500) %}
    {
      "name": "index-append-ids",
      "operation-type": "bulk",
      "param-source": "upsert-source",
      "action": "index",
      "revision": 0,
      "bulk-size": {{p_bulk_size}},
      "ingest-percentage": {{ingest_percentage | default(100)}},
      "upsert-seed": {{upsert_seed | default(42)}}{% if corpus_file is defined %},
      "corpus-file": {{corpus_file | tojson}}{% endif %}
    },
    {
      "name": "index-update-native",
      "operation-type": "bulk",
      "param-source": "upsert-source",
      "action": "update",
      "revision": 1,
      "bulk-size": {{p_bulk_size}},
      "ingest-percentage": {{ingest_percentage | default(100)}},
      "upsert-seed": {{upsert_seed | default(42)}}{% if corpus_file is defined %},
      "corpus-file": {{corpus_file | tojson}}{% endif %}
    },
    {
      "name": "upsert-insert",
      "operation-type": "bulk",
      "param-source": "upsert-source",
      "action": "upsert",
      "revision": 0,
      "bulk-size": {{p_bulk_size}},
      "ingest-percentage": {{ingest_percentage | default(100)}},
      "new-doc-ratio": 0,
      "upsert-seed": {{upsert_seed | default(42)}}{% if corpus_file is defined %},
      "corpus-file": {{corpus_file | tojson}}{% endif %}
    },
    {
      "name": "upsert-update",
      "operation-type": "bulk",
      "param-source": "upsert-source",
      "action": "upsert",
      "revision": 1,
      "bulk-size": {{p_bulk_size}},
      "ingest-percentage": {{ingest_percentage | default(100)}},
      "new-doc-ratio": 0,
      "upsert-seed": {{upsert_seed | default(42)}}{% if corpus_file is defined %},
      "corpus-file": {{corpus_file | tojson}}{% endif %}
    },
    {
      "name": "upsert-mixed",
      "operation-type": "bulk",
      "param-source": "upsert-source",
      "action": "upsert",
      "revision": 2,
      "bulk-size": {{p_bulk_size}},
      "ingest-percentage": {{ingest_percentage | default(100)}},
      "new-doc-ratio": {{new_doc_ratio | default(25)}},
      "new-id-offset": {{new_id_offset | default(1000000000)}},
      "upsert-seed": {{upsert_seed | default(42)}}{% if corpus_file is defined %},
      "corpus-file": {{corpus_file | tojson}}{% endif %}
    },
    {
      "name": "index-stats",
      "operation-type": "index-stats",
      "index": "_all"
    },
    {
      "name": "refresh",
      "operation-type": "refresh"
    },
    {
      "name": "force-merge",
      "operation-type": "force-merge",
      "request-timeout": 7200
    },
    {
      "name": "wait-until-merges-finish",
      "operation-type": "index-stats",
      "index": "_all",
      "condition": {
        "path": "_all.total.merges.current",
        "expected-value": 0
      },
      "retry-until-success": true,
      "include-in-reporting": false
    }
